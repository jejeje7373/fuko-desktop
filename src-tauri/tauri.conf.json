{
  "identifier": "com.claudia.desktop",
  "productName": "Claudia Desktop Companion",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay_window",
        "title": "Fuko",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "bubble_window",
        "title": "Fuko Dialogue",
        "width": 440,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "url": "bubble.html"
      }
    ]
  }
}
