{
  "$schema": "https://tauri.app/schemas/tauri-config.json",
  "identifier": "com.claudia.desktop",
  "productName": "Claudia Desktop Companion",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay_window",
        "title": "Claudia",
        "width": 360,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public/*",
      "../public/sprites/*"
    ]
  }
}
